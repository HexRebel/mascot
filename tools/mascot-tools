"""aichat runs bin/<tool> '<json arguments>' with LLM_OUTPUT set to a file it
reads the result from (the llm-functions layout, see functions.json). Every
bin/<tool> is a link to this script, which picks the tool by its own name.

Nothing here writes or deletes anything but the todo list and the reminders,
Mascot's own MASCOT_TODO_FILE and MASCOT_REMINDER_FILE. The file tools only see
the home directory without hidden files and directories (no dotfiles, .ssh,
.config, .env...). The file, todo and reminder tools only work when the bubble
says the model is local (MASCOT_TOOLS_LOCAL=1), so what they read stays on this
computer."""

import fcntl
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request

READ_LIMIT = 64 * 1024  # bytes of a file handed to the model
LIST_LIMIT = 200  # entries of a directory
TODO_LIMIT = 300  # characters of a todo item or a reminder


class ToolError(Exception):
    pass


def get_current_weather(args):
    # Only the place name leaves the computer; none means wttr.in's guess by IP
    location = str(args.get("location") or "").strip()
    url = "https://wttr.in/" + urllib.parse.quote(location.replace(" ", "+"), safe="+,")
    url += "?format=" + urllib.parse.quote("%l: %C, %t (feels like %f), wind %w, humidity %h, rain %p") + "&M"
    request = urllib.request.Request(url, headers={"User-Agent": "curl/8"})  # plain text, not HTML
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.read(4096).decode("utf-8", "replace").strip()
    except OSError as e:
        raise ToolError(f"could not get the weather: {e}")


def home_path(path):
    """The real path under home for path (relative to home), or ToolError"""
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("files can only be read with a local model")
    home = os.path.realpath(os.path.expanduser("~"))
    path = os.path.expanduser(str(path or "~").strip() or "~")
    if not os.path.isabs(path):
        path = os.path.join(home, path)
    # Both as written and with links resolved: a link may not lead out of home
    # or into a hidden directory
    for candidate in (os.path.normpath(path), os.path.realpath(path)):
        rel = os.path.relpath(candidate, home)
        if rel == ".." or rel.startswith("../"):
            raise ToolError("only files in the home directory can be read")
        if any(part.startswith(".") and part != "." for part in rel.split(os.sep)):
            raise ToolError("hidden files and directories are private")
    return os.path.realpath(path)


def shown(path):
    home = os.path.realpath(os.path.expanduser("~"))
    rel = os.path.relpath(path, home)
    return "~" if rel == "." else "~/" + rel


def list_directory(args):
    path = home_path(args.get("path"))
    try:
        entries = sorted(os.scandir(path), key=lambda e: e.name.lower())
    except OSError as e:
        raise ToolError(f"cannot list {shown(path)}: {e.strerror}")
    names = []
    for entry in entries:
        if entry.name.startswith("."):
            continue
        try:
            names.append(entry.name + ("/" if entry.is_dir() else ""))
        except OSError:
            names.append(entry.name)
    lines = [f"{shown(path)}:"] + names[:LIST_LIMIT]
    if len(names) > LIST_LIMIT:
        lines.append(f"... and {len(names) - LIST_LIMIT} more")
    if not names:
        lines.append("(empty)")
    return "\n".join(lines)


def read_file(args):
    path = home_path(args.get("path"))
    if os.path.isdir(path):
        raise ToolError(f"{shown(path)} is a directory, use list_directory")
    try:
        with open(path, "rb") as file:
            data = file.read(READ_LIMIT + 1)
    except OSError as e:
        raise ToolError(f"cannot read {shown(path)}: {e.strerror}")
    if b"\0" in data[:8192]:
        raise ToolError(f"{shown(path)} is not a text file")
    text = data[:READ_LIMIT].decode("utf-8", "replace")
    if len(data) > READ_LIMIT:
        text += f"\n... (only the first {READ_LIMIT // 1024} KB are shown)"
    return text


# The todo list is a Markdown file: one "- [ ] item" line per item; other lines
# (a heading, notes) are kept as they are. Items are numbered from 1 in order
TODO_ITEM = "- [ ] "


def todo_file():
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("the todo list is only there with a local model")
    path = os.environ.get("MASCOT_TODO_FILE", "")
    if not os.path.isabs(path):
        raise ToolError("no todo list")
    return path


def todo_change(change):
    return locked_change(todo_file(), change)


def locked_change(path, change):
    """Runs change(lines) -> message on the file's lines, under a lock on its
    directory, and writes them back (atomically) if they changed"""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    lock = os.open(directory, os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(path, encoding="utf-8") as file:
                lines = file.read().splitlines()
        except FileNotFoundError:
            lines = []
        before = list(lines)
        message = change(lines)
        if lines != before:
            temp = f"{path}.{os.getpid()}.tmp"
            with open(temp, "w", encoding="utf-8") as file:
                file.write("".join(line + "\n" for line in lines))
            os.replace(temp, path)
        return message
    finally:
        os.close(lock)


def changed(note):
    """Tells the bubble what really changed (on stderr, which aichat passes on),
    so it can show it whatever the reply claims"""
    print(f"mascot-tools: {note}", file=sys.stderr)


def todo_items(lines):
    """(line index, text) of each item"""
    return [(i, line[len(TODO_ITEM):].strip()) for i, line in enumerate(lines)
            if line.startswith(TODO_ITEM) and line[len(TODO_ITEM):].strip()]


def todo_listing(lines):
    items = todo_items(lines)
    if not items:
        return "The todo list is empty."
    return "\n".join(f"{n}. {text}" for n, (_, text) in enumerate(items, 1))


def list_todos(args):
    def listing(lines):
        # The user never sees a tool's output, and models like to say "here is
        # your list" without it: the bubble shows these if the reply has not
        print("mascot-todos: " + json.dumps([text for _, text in todo_items(lines)]),
              file=sys.stderr)
        return todo_listing(lines)
    return todo_change(listing)


def add_todo(args):
    text = " ".join(str(args.get("item") or "").split())[:TODO_LIMIT]
    if not text:
        raise ToolError("nothing to add")

    def change(lines):
        lines.append(TODO_ITEM + text)
        changed(f"todo: added {text}")
        return f"added: {text}\n\n" + todo_listing(lines)
    return todo_change(change)


def find_todo(lines, which):
    """(line index, text) of the one item which names: its number or (part of) its text"""
    items = todo_items(lines)
    if which.isdigit():
        n = int(which)
        if not 1 <= n <= len(items):
            raise ToolError(f"there is no item {n}\n\n" + todo_listing(lines))
        return items[n - 1]
    found = [item for item in items if item[1].lower() == which.lower()] \
        or [item for item in items if which.lower() in item[1].lower()]
    if not found:
        raise ToolError(f"no item matches \"{which}\"\n\n" + todo_listing(lines))
    if len(found) > 1:
        raise ToolError(f"more than one item matches \"{which}\": "
                        + "; ".join(text for _, text in found) + " - say which by its number")
    return found[0]


def find_todos(lines, which):
    """The items which names, by the numbers they have now: one item (see
    find_todo), or several, e.g. "1, 4", "1 og 4", "milk; bread" """
    try:
        return [find_todo(lines, which)]
    except ToolError as one:
        parts = [part for part in re.split(r"\s*(?:,|;|\band\b|\bog\b|\s(?=\d+(?:\s|,|$)))\s*", which) if part]
        if len(parts) < 2:
            raise one
        found = []
        for part in parts:
            item = find_todo(lines, part)
            if item not in found:
                found.append(item)
        return found


def remove_todo(args):
    which = " ".join(str(args.get("item") or "").split())
    if not which:
        raise ToolError("say which item to remove")

    def change(lines):
        found = find_todos(lines, which)
        for index, text in sorted(found, reverse=True):
            del lines[index]
        for _, text in found:
            changed(f"todo: removed {text}")
        return "removed: " + "; ".join(text for _, text in found) + "\n\n" + todo_listing(lines)
    return todo_change(change)


def edit_todo(args):
    which = " ".join(str(args.get("item") or "").split())
    text = " ".join(str(args.get("text") or "").split())[:TODO_LIMIT]
    if not which:
        raise ToolError("say which item to change")
    if not text:
        raise ToolError("say what the item should say instead")

    def change(lines):
        index, old = find_todo(lines, which)
        lines[index] = TODO_ITEM + text
        changed(f"todo: changed {old} → {text}")
        return f"changed: {old} → {text}\n\n" + todo_listing(lines)
    return todo_change(change)


# The reminders are a Markdown file too, one "- YYYY-MM-DD HH:MM[:SS] text" line
# per reminder (local time), kept in time order; other lines are kept. The
# bubble reads it itself and shows each one when it is due, or when Mascot
# starts, if it was not running then; due_reminders then takes them off
REMINDER = re.compile(r"^- (\d{4}-\d\d-\d\d \d\d:\d\d(?::\d\d)?) (.*\S)\s*$")
UNITS = {"s": 1, "m": 60, "h": 3600, "t": 3600, "d": 86400}
DAYS = {"i dag": 0, "idag": 0, "today": 0, "i morgen": 1, "imorgen": 1, "tomorrow": 1}


def reminder_file():
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("reminders are only there with a local model")
    path = os.environ.get("MASCOT_REMINDER_FILE", "")
    if not os.path.isabs(path):
        raise ToolError("no reminders")
    return path


def parse_when(when, now):
    """The time (epoch seconds) for when: a duration ("10m", "1h30m", "2 hours",
    "45 sek"; a bare number is minutes), a time of day ("12:00", "kl. 12",
    today or else tomorrow), or a date and time ("2026-10-19 12:00",
    "19.10.26 12:00", "19.10 kl 12", "i morgen 12:00", "tomorrow 9"); None if it
    is none of them"""
    when = " ".join(when.lower().split())
    clock = bool(re.search(r"\bkl\b", when))  # "kl 12" is a time, "12" minutes
    when = re.sub(r"^(in|om) ", "", re.sub(r"\s*\bkl\b\.?\s*", " ", when).strip())
    days = None  # "i morgen 12:00": days from today
    m = re.match(r"(i morgen|imorgen|tomorrow|i dag|idag|today) ", when)
    if m:
        days, clock, when = DAYS[m.group(1)], True, when[m.end():]
    if re.fullmatch(r"\d+", when) and not clock:
        return now + int(when) * 60
    if re.fullmatch(r"(\d+\s*[a-zæøå]+\s*((and|og)\s*)?)+", when):
        parts = re.findall(r"(\d+)\s*([a-zæøå]+)", when)
        if not all(unit[0] in UNITS for _, unit in parts):
            return None
        return now + sum(int(n) * UNITS[unit[0]] for n, unit in parts)
    # [date ]hour[:minute[:second]]; "19.10" alone is a time, as in Danish
    m = re.fullmatch(r"(?:(?:(\d{4})-(\d\d?)-(\d\d?)|(\d\d?)\.(\d\d?)\.?(\d{4}|\d\d)?)[ t])?"
                     r"(\d\d?)(?:[:.](\d\d))?(?::(\d\d))?", when)
    if not m or not (m.group(8) or clock or m.group(1) or m.group(4)) or (days is not None and (m.group(1) or m.group(4))):
        return None
    if m.group(1):
        year, month, day = int(m.group(1)), int(m.group(2)), int(m.group(3))
    elif m.group(4):
        y = m.group(6)
        year = (int(y) + (2000 if len(y) == 2 else 0)) if y else time.localtime(now).tm_year
        month, day = int(m.group(5)), int(m.group(4))
    else:
        year, month, day = time.localtime(now)[:3]
        day += days or 0
    hour, minute, second = int(m.group(7)), int(m.group(8) or 0), int(m.group(9) or 0)
    if not (1 <= month <= 12 and 1 <= day <= 31 and hour < 24 and minute < 60 and second < 60):
        return None
    at = time.mktime((year, month, day, hour, minute, second, 0, 0, -1))
    # A time of day that has passed is tomorrow's, a date without a year next year's
    if at <= now and not (m.group(1) or m.group(6) or days is not None):
        if m.group(4):
            year += 1
        else:
            day += 1
        at = time.mktime((year, month, day, hour, minute, second, 0, 0, -1))
    return at


def stamp(at):
    seconds = time.localtime(at).tm_sec
    return time.strftime("%Y-%m-%d %H:%M:%S" if seconds else "%Y-%m-%d %H:%M", time.localtime(at))


def shown_time(at):
    return time.strftime("%a %Y-%m-%d %H:%M", time.localtime(at))


def reminder_items(lines):
    """(line index, epoch seconds, text) of each reminder, in time order"""
    items = []
    for i, line in enumerate(lines):
        m = REMINDER.match(line)
        if m:
            fmt = "%Y-%m-%d %H:%M:%S" if m.group(1).count(":") == 2 else "%Y-%m-%d %H:%M"
            try:
                items.append((i, time.mktime(time.strptime(m.group(1), fmt)), m.group(2)))
            except ValueError:
                pass
    return sorted(items, key=lambda item: item[1])


def reminder_listing(lines):
    items = reminder_items(lines)
    if not items:
        return "There are no reminders."
    return "\n".join(f"{n}. {shown_time(at)}: {text}" for n, (_, at, text) in enumerate(items, 1))


def keep_in_order(lines):
    """Puts the reminder lines in time order, after any other lines"""
    items = reminder_items(lines)
    reminders = [lines[i] for i, _, _ in items]
    lines[:] = [line for i, line in enumerate(lines) if i not in {i for i, _, _ in items}] + reminders


def set_reminder(args):
    now = time.time()
    when = " ".join(str(args.get("when") or "").split())
    text = " ".join(str(args.get("text") or "").split())[:TODO_LIMIT]
    if not when and text:
        # .remind <when> <text>: the longest start of it that is a time
        words = text.split()
        for n in range(len(words) - 1, 0, -1):
            if parse_when(" ".join(words[:n]), now) is not None:
                when, text = " ".join(words[:n]), " ".join(words[n:])
                break
    if not text:
        raise ToolError("say what to remind of")
    if not when:
        raise ToolError("say when, e.g. 10m, 1h30m, 12:00 or 2026-10-19 12:00")
    at = parse_when(when, now)
    if at is None:
        raise ToolError(f"cannot tell when \"{when}\" is - use e.g. 10m, 1h30m, 12:00 or 2026-10-19 12:00")
    if at <= now:
        raise ToolError(f"{shown_time(at)} has passed")

    def change(lines):
        lines.append(f"- {stamp(at)} {text}")
        keep_in_order(lines)
        changed(f"reminder: {shown_time(at)}: {text}")
        return f"set for {shown_time(at)}: {text}\n\n" + reminder_listing(lines)
    return locked_change(reminder_file(), change)


def list_reminders(args):
    return locked_change(reminder_file(), reminder_listing)


def cancel_reminder(args):
    which = " ".join(str(args.get("item") or "").split())
    if not which:
        raise ToolError("say which reminder to cancel")

    def change(lines):
        items = reminder_items(lines)
        if which.isdigit():
            n = int(which)
            if not 1 <= n <= len(items):
                raise ToolError(f"there is no reminder {n}\n\n" + reminder_listing(lines))
            found = [items[n - 1]]
        else:
            found = [item for item in items if item[2].lower() == which.lower()] \
                or [item for item in items if which.lower() in item[2].lower()]
        if not found:
            raise ToolError(f"no reminder matches \"{which}\"\n\n" + reminder_listing(lines))
        if len(found) > 1:
            raise ToolError(f"more than one reminder matches \"{which}\": "
                            + "; ".join(text for _, _, text in found) + " - say which by its number")
        index, at, text = found[0]
        del lines[index]
        changed(f"reminder cancelled: {shown_time(at)}: {text}")
        return f"cancelled: {text}\n\n" + reminder_listing(lines)
    return locked_change(reminder_file(), change)


def due_reminders(args):
    """For the bubble, not the model: takes off the reminders due by "until"
    (epoch seconds), once it has shown them"""
    until = float(args.get("until") or 0)

    def change(lines):
        due = {i for i, at, _ in reminder_items(lines) if at <= until}
        lines[:] = [line for i, line in enumerate(lines) if i not in due]
        return f"{len(due)} done"
    return locked_change(reminder_file(), change)


TOOLS = {f.__name__: f for f in (get_current_weather, list_directory, read_file, list_todos, add_todo, remove_todo, edit_todo,
                                 set_reminder, list_reminders, cancel_reminder, due_reminders)}


def main():
    name = os.path.basename(sys.argv[0])
    try:
        if name not in TOOLS:
            raise ToolError(f"unknown tool {name}")
        try:
            args = json.loads(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].strip() else {}
        except json.JSONDecodeError:
            raise ToolError("invalid JSON arguments")
        result = TOOLS[name](args if isinstance(args, dict) else {})
    except ToolError as e:
        result = f"error: {e}"  # for the model, which can tell the user
    output = os.environ.get("LLM_OUTPUT")
    if output:
        with open(output, "a", encoding="utf-8") as file:
            file.write(result + "\n")
    else:
        print(result)


if __name__ == "__main__":
    main()
