                                 local_model, check_system, read_log)}


def main():
    name = os.path.basename(sys.argv[0])
    # The todo list and the reminders are only the user's, whatever the umask
    os.umask(0o077)
    try:
        if name not in TOOLS:
            raise ToolError(f"unknown tool {name}")
        # aichat runs any tool in functions.json the model calls, not only those in AICHAT_USE_TOOLS: only the
        # ones the bubble chose for this answer run (none without the list)
        if name not in os.environ.get("MASCOT_TOOLS_ALLOWED", "").split(","):
            raise ToolError(f"{name} is not turned on; do not try other ways to get what it would give")
        # Local is where aichat sends the model (its api_base, not OLLAMA_HOST),
        # and not a copy of one of Ollama's cloud models (ollama cp x:cloud
        # mine), which runs at ollama.com: else the local-only tools refuse
        model = os.environ.get("MASCOT_VISION_MODEL", "")
        if os.environ.get("MASCOT_TOOLS_LOCAL") == "1" and model:
            base = aichat_ollama_base()
            show = ollama_show(model) if base and loopback(base) else None
            if show is None or show.get("remote_host") or show.get("remote_model"):
                os.environ["MASCOT_TOOLS_LOCAL"] = "0"
        try:
            args = json.loads(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].strip() else {}
        except json.JSONDecodeError:
            raise ToolError("invalid JSON arguments")
        # What it is doing, for the bubble to show while it waits
        print("mascot-doing: " + json.dumps({"tool": name, "args": args}, ensure_ascii=False),
              file=sys.stderr, flush=True)
        result = TOOLS[name](args if isinstance(args, dict) else {})
    except ToolError as e:
        result = f"error: {e}"  # for the model, which can tell the user
        if NOT_LOCAL_WHY and "local model" in str(e):
            result += f" (why it is not counted as local: {NOT_LOCAL_WHY})"
    output = os.environ.get("LLM_OUTPUT")
    language = " ".join(os.environ.get("MASCOT_LANGUAGE", "").split())[:40]
    if output and language:  # the last thing the model reads before it answers: a small one drifts otherwise
        result += (f"\n\n(Answer the user in {language}, not in a language close to it, unless the user writes in "
                   "another language.)")
    if output:
        with open(output, "a", encoding="utf-8") as file:
            file.write(result + "\n")
        # What this put in the conversation's memory, which the bubble counts
        print(f"mascot-size: {len(result)}", file=sys.stderr)
    else:
        print(result)


if __name__ == "__main__":
    main()
