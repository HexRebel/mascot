"""aichat runs bin/<tool> '<json arguments>' with LLM_OUTPUT set to a file it
reads the result from (the llm-functions layout, see functions.json). Every
bin/<tool> is a link to this script, which picks the tool by its own name.

Nothing here writes or deletes anything but the todo list and the reminders,
Mascot's own MASCOT_TODO_FILE and MASCOT_REMINDER_FILE. The file tools only see
the home directory, and no hidden files or directories but the ones the user
let them see (CHAT_DOTFILES, passed as MASCOT_DOTFILES). Even there, never where
secrets are kept (SECRET_DIRS and SECRET_NAMES: .ssh, keys, tokens, browser
profiles, shell history...). The file, todo and reminder tools only work when the bubble
says the model is local (MASCOT_TOOLS_LOCAL=1), so what they read stays on this
computer. So does last_commands, the one tool that reads shell history: only
its last commands, and never one that looks like it holds a secret. And so do
check_system and read_log, which read what the system's own tools and log say
(nmcli, ss, UFW's rules, wpctl, coredumpctl, systemctl, journalctl), never
with sudo, with what looks like a password or key in a log line hidden."""

import base64
import fcntl
import ipaddress
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# Bytes of a file handed to the model: about a quarter of the local model's
# context (see read_limit()), 12 KB for 16k tokens; more pushes the start of
# the conversation (the question) out, which Ollama does silently
READ_LIMIT = 12 * 1024  # if Ollama cannot say
OLLAMA_DEFAULT_CONTEXT = 4096  # tokens, for a model without num_ctx
SEARCH_FILE_LIMIT = 1024 * 1024  # bytes of one file searched
LIST_LIMIT = 200  # entries of a directory (or a tree)
TREE_DEPTH = 4  # levels of a tree
TODO_LIMIT = 300  # characters of a todo item or a reminder
IMAGE_LIMIT = 30 * 1024 * 1024  # bytes of an image handed to Ollama
COMMANDS_LIMIT = 10  # shell commands last_commands shows
COMMANDS_LEAST = 5  # ...at least: models ask for 1 even for "the find command before"
HISTORY_TAIL = 64 * 1024  # bytes read from the end of a shell's history


# Never read, listed or gone into, wherever they are under home (also inside
# e.g. ~/.dotfiles/aichat/.config/aichat): component sequences of a path...
SECRET_DIRS = [d.split("/") for d in (
    # keys, passwords, tokens
    ".ssh", ".gnupg", ".password-store", ".local/share/keyrings", ".local/share/kwalletd", ".pki", ".android",
    ".config/aichat", ".config/aichat-bubble", ".claude", ".local/share/claude", ".config/gh", ".aws", ".kube",
    ".docker", ".qwen", ".config/goa-1.0", ".config/rclone", ".config/hydroxide", ".MakeMKV",
    # browsers, mail, chat and other apps that keep logins
    ".mozilla", ".config/mozilla", ".librewolf", ".thunderbird", ".local/share/qutebrowser", ".config/chromium",
    ".config/google-chrome", ".config/BraveSoftware", ".config/vivaldi", ".config/microsoft-edge", ".config/Google",
    ".config/discord", ".config/Signal", ".config/Element", ".config/Caprine", ".config/Electron",
    ".config/Mailspring", ".config/protonmail", ".config/Proton Mail", ".config/Proton Pass",
    ".local/share/protonmail", ".local/share/proton-drive-cli", ".config/spotify", ".config/spicetify",
    ".config/spotify-player", ".config/ncspot", ".config/VSCodium", ".vscode-oss", ".config/obsidian",
    ".config/obs-studio", ".config/Mumble", ".local/share/Mumble", ".config/onlyoffice", ".config/Epic",
    ".config/CurseForge", ".config/ow-electron", ".config/millennium", ".local/share/millennium",
    ".config/youtube-tui", ".local/share/youtube-tui", ".local/share/rustypipe", ".local/share/TelegramDesktop",
    ".local/share/org.localsend.localsend_app", ".local/share/folks", ".steam", ".local/share/Steam",
    # history, caches and whole app sandboxes
    ".local/share/fish", ".local/share/zsh", ".local/share/zoxide", ".cache", ".var", ".wine", ".git",
    # environment variables, where keys tend to end up
    ".config/environment.d", ".config/uwsm")]
# ...and names of files or directories: keys, tokens, shell history, and what
# browsers and Electron apps keep logins and history in
SECRET_NAMES = re.compile(r"""^(\.env(\..*)?|.*\.env|.*\.(pem|key|p12|pfx|kdbx|keystore|asc|gpg|sqlite3?|db|ldb|vdf|xbel)
    |id_(rsa|dsa|ecdsa|ed25519)(_sk)?(\.pub)?|adbkey(\.pub)?|\.netrc|\.git-credentials|\.npmrc|\.pypirc|\.pgpass
    |\.claude\.json|\.pulse-cookie|credentials(\..*)?|secrets?(\..*)?|token(s)?(\..*)?
    |cookies(\..*)?|login\ data|web\ data|local\ storage|session\ storage|indexeddb|leveldb|logins\.json
    |\.(zsh|bash|python|node_repl|sqlite|mysql|psql|lesshst)_?history|\.histfile|\.viminfo|\.wget-hsts)$""", re.X | re.I)


class ToolError(Exception):
    pass


def is_secret(rel):
    """Whether rel (relative to home) is or is inside a secret place"""
    parts = [part for part in rel.split(os.sep) if part not in ("", ".")]
    if any(SECRET_NAMES.match(part) for part in parts):
        return True
    return any(parts[i:i + len(d)] == d for d in SECRET_DIRS for i in range(len(parts) - len(d) + 1))


def get_current_weather(args):
    # Only the place name leaves the computer; none means wttr.in's guess by IP
    location = str(args.get("location") or "").strip()
    url = "https://wttr.in/" + urllib.parse.quote(location.replace(" ", "+"), safe="+,")
    url += "?format=" + urllib.parse.quote("%l: %C, %t (feels like %f), wind %w, humidity %h, rain %p") + "&M"
    request = urllib.request.Request(url, headers={"User-Agent": "curl/8"})  # plain text, not HTML
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.read(4096).decode("utf-8", "replace").strip()
    except OSError as e:
        raise ToolError(f"could not get the weather: {e}")


def allowed_dotfiles():
    """The hidden files and directories the user let the tools see
    (CHAT_DOTFILES, ";"-separated), each as written and with links resolved:
    e.g. ~/.config/hypr and the ~/.dotfiles/hypr/.config/hypr it links to"""
    home = os.path.realpath(os.path.expanduser("~"))
    allowed = set()
    for entry in os.environ.get("MASCOT_DOTFILES", "").split(";"):
        entry = os.path.expanduser(entry.strip())
        if not entry:
            continue
        entry = os.path.join(home, entry) if not os.path.isabs(entry) else entry
        allowed.update((os.path.normpath(entry), os.path.realpath(entry)))
    return allowed


def under(path, directory):
    return path == directory or path.startswith(directory.rstrip("/") + "/")


def check_path(path, listing=False):
    """None if path (absolute) may be read, else why not. A hidden one only
    inside CHAT_DOTFILES, or, for listing, a directory on the way to one
    (~/.config for ~/.config/hypr). Both as written and with links resolved: a
    link may not lead out of home, into a secret place or a hidden one not allowed"""
    home = os.path.realpath(os.path.expanduser("~"))
    allowed = allowed_dotfiles()
    for candidate in (os.path.normpath(path), os.path.realpath(path)):
        rel = os.path.relpath(candidate, home)
        if rel == ".." or rel.startswith("../"):
            return "only files in the home directory can be read"
        if is_secret(rel):
            return f"{shown(candidate)} is private (where keys, tokens or history are kept)"
        hidden = any(part.startswith(".") for part in rel.split(os.sep) if part != ".")
        if hidden and not any(under(candidate, a) or (listing and under(a, candidate)) for a in allowed):
            return f"{shown(candidate)} is hidden; the mascot only sees the dotfiles listed in CHAT_DOTFILES"
    return None


def on_the_way(path):
    """Whether path is a directory on the way to an allowed dotfile (~/.config
    for ~/.config/hypr), so it is shown in listings even without hidden"""
    allowed = allowed_dotfiles()
    return any(a != candidate and under(a, candidate)
               for candidate in (os.path.normpath(path), os.path.realpath(path)) for a in allowed)


def ollama_url(endpoint):
    host = os.environ.get("OLLAMA_HOST", "") or "127.0.0.1:11434"
    return (host if "://" in host else "http://" + host).rstrip("/") + endpoint


def context_tokens():
    """The local model's context in tokens, as Ollama runs it: its num_ctx,
    or Ollama's default, at most what the model can; None if unknown"""
    model = os.environ.get("MASCOT_VISION_MODEL", "")
    if not model:
        return None
    request = urllib.request.Request(ollama_url("/api/show"), data=json.dumps({"model": model}).encode(),
                                     headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            show = json.loads(response.read())
    except (OSError, ValueError):
        return None
    m = re.search(r"^num_ctx\s+(\d+)", str(show.get("parameters") or ""), re.M)
    tokens = int(m.group(1)) if m else OLLAMA_DEFAULT_CONTEXT
    most = [v for k, v in (show.get("model_info") or {}).items()
            if k.endswith(".context_length") and "original" not in k and isinstance(v, int)]
    return min([tokens] + most)


def context_size(args):
    """For the bubble, not the model: the local model's context in tokens (0:
    unknown), so a mascot's memory stays well inside it"""
    return str(context_tokens() or 0)


def read_limit():
    """Bytes of a file to hand the model: a quarter of its context (at about 3
    bytes a token), so the prompt, the conversation and the answer still fit"""
    tokens = context_tokens()
    return max(2048, tokens * 3 // 4) if tokens else READ_LIMIT


def home_path(path, listing=False):
    """(the real path under home, the path as asked for) for path (relative to
    home), or ToolError"""
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("files can only be read with a local model")
    home = os.path.realpath(os.path.expanduser("~"))
    path = os.path.expanduser(str(path or "~").strip() or "~")
    if not os.path.isabs(path):
        path = os.path.join(home, path)
    why = check_path(path, listing)
    if why:
        raise ToolError(why)
    return os.path.realpath(path), os.path.normpath(path)


def shown(path):
    home = os.path.realpath(os.path.expanduser("~"))
    rel = os.path.relpath(path, home)
    return "~" if rel == "." else "~/" + rel


def visible_entries(path, hidden=False, left_out=None):
    """(name, is a directory to go into) of what is in path, sorted, only what
    check_path() lets through (and dotfiles only if hidden, or on the way to an
    allowed one). Links to directories are gone into like directories (dotfiles
    are often links, e.g. stow's); check_path() has checked where they lead,
    and TREE_DEPTH and LIST_LIMIT keep a loop short. left_out (a list) gets
    one item per entry not shown"""
    entries = []
    for entry in sorted(os.scandir(path), key=lambda e: e.name.lower()):
        full = os.path.join(path, entry.name)
        if (entry.name.startswith(".") and not hidden and not on_the_way(full)) \
                or check_path(full, listing=True):
            if left_out is not None:
                left_out.append(entry.name)
            continue
        try:
            is_dir = entry.is_dir()
            entries.append((entry.name + ("/" if is_dir else ""), is_dir))
        except OSError:
            entries.append((entry.name, False))
    return entries


def nothing_shown(left_out):
    return "(nothing here the mascot may see: only private or hidden files, or dotfiles not in CHAT_DOTFILES)" \
        if left_out else "(empty)"


def list_directory(args):
    path, asked = home_path(args.get("path"), listing=True)
    try:
        depth = max(1, min(int(args.get("depth") or 1), TREE_DEPTH))
    except (TypeError, ValueError):
        depth = 1
    try:
        hidden = args.get("hidden") in (True, "true", "1", 1)
        left_out = []
        entries = visible_entries(path, hidden, left_out)
    except OSError as e:
        raise ToolError(f"cannot list {shown(asked)}: {e.strerror}")
    if depth == 1:
        names = [name for name, _ in entries]
        lines = [f"{shown(asked)}:"] + names[:LIST_LIMIT]
        if len(names) > LIST_LIMIT:
            lines.append(f"... and {len(names) - LIST_LIMIT} more")
        if not names:
            lines.append(nothing_shown(left_out))
        return "\n".join(lines)

    # A tree, as the tree command draws it, at most LIST_LIMIT entries in all
    lines = [shown(asked) + "/"]
    left = [LIST_LIMIT]

    def walk(directory, entries, prefix, level):
        for n, (name, is_dir) in enumerate(entries):
            if left[0] <= 0:
                if left[0] == 0:  # said once, not again on each level
                    lines.append(f"... (only the first {LIST_LIMIT} are shown)")
                    left[0] = -1
                return
            last = n == len(entries) - 1
            lines.append(prefix + ("└── " if last else "├── ") + name)
            left[0] -= 1
            if is_dir and level < depth:
                inner = os.path.join(directory, name.rstrip("/"))
                try:
                    walk(inner, visible_entries(inner, hidden), prefix + ("    " if last else "│   "), level + 1)
                except OSError:
                    pass
    walk(path, entries, "", 1)
    if not entries:
        lines.append(nothing_shown(left_out))
    tree = "\n".join(lines)
    # Models like to say "here is the tree" without it: the bubble shows it if
    # the reply has not (the names are what it looks for)
    print("mascot-show: " + json.dumps({"text": tree, "names": [line.split("── ", 1)[1] for line in lines
                                                              if "── " in line]}), file=sys.stderr)
    return tree


def not_found(asked):
    """ToolError for a file that is not there, saying what is in its directory
    (models like to guess names, e.g. hyprland.conf for hyprland.lua)"""
    directory = os.path.dirname(asked)
    try:
        if check_path(directory, listing=True):
            raise OSError
        names = [name for name, _ in visible_entries(os.path.realpath(directory), hidden=True)]
    except OSError:
        return ToolError(f"there is no {shown(asked)}")
    listing = ", ".join(names[:40]) + (", ..." if len(names) > 40 else "") if names else "nothing to show"
    return ToolError(f"there is no {shown(asked)}; {shown(directory)} has: {listing}")


def read_file(args):
    path, asked = home_path(args.get("path"))
    if os.path.isdir(path):
        raise ToolError(f"{shown(asked)} is a directory, use list_directory")
    limit = read_limit()
    try:
        with open(path, "rb") as file:
            data = file.read(limit + 1)
    except FileNotFoundError:
        raise not_found(asked)
    except OSError as e:
        raise ToolError(f"cannot read {shown(asked)}: {e.strerror}")
    if b"\0" in data[:8192]:
        raise ToolError(f"{shown(asked)} is not a text file")
    if len(data) <= limit:
        return data.decode("utf-8", "replace")
    size = os.path.getsize(path)
    shown_part = data[:limit]
    shown_part = shown_part[:shown_part.rfind(b"\n") + 1] or shown_part  # whole lines
    return shown_part.decode("utf-8", "replace") + (
        f"\n... (the file is {size // 1024} KB; only the first {len(shown_part) // 1024} KB are shown. "
        "Use search_file to find something further on)")


def text_files(path, left):
    """The readable text files at path (a file, or the files in a directory and
    the ones below it, as list_directory would show them), at most left[0]"""
    if not os.path.isdir(path):
        yield path
        return
    stack = [(path, 1)]
    while stack and left[0] > 0:
        directory, level = stack.pop()
        try:
            entries = visible_entries(directory)
        except OSError:
            continue
        for name, is_dir in reversed(entries):
            full = os.path.join(directory, name.rstrip("/"))
            if is_dir:
                if level < TREE_DEPTH:
                    stack.append((full, level + 1))
            elif left[0] > 0:
                left[0] -= 1
                yield full


def search_file(args):
    """The lines of a file (or of the files in a directory) with text in them,
    with a line around each, so a big file need not be read whole"""
    path, asked = home_path(args.get("path"), listing=True)
    words = " ".join(str(args.get("text") or "").split())
    if not words:
        raise ToolError("say what to search for")
    needle = words.lower()
    out, used, found = [], 0, 0
    limit = read_limit() * 2 // 3  # what is found, 8 KB for 16k tokens
    many = os.path.isdir(path)
    for file in text_files(path, [500]):
        if check_path(file):
            continue
        try:
            with open(file, "rb") as f:
                data = f.read(SEARCH_FILE_LIMIT)
        except FileNotFoundError:
            if not many:
                raise not_found(asked)
            continue
        except OSError:
            continue
        if b"\0" in data[:8192]:
            if not many:
                raise ToolError(f"{shown(asked)} is not a text file")
            continue
        lines = data.decode("utf-8", "replace").splitlines()
        hits = [i for i, line in enumerate(lines) if needle in line.lower()]
        if not hits:
            continue
        # The file as asked for (e.g. ~/.config/hypr/...), not where a link leads
        name = shown(os.path.join(asked, os.path.relpath(file, path)) if many else asked)
        block, last = [f"{name}:"], -2
        for i in hits:
            for j in range(max(0, i - 1), min(len(lines), i + 2)):
                if j > last:
                    if j > last + 1 and last >= 0:
                        block.append("  ...")
                    block.append(f"  {j + 1}: {lines[j][:300]}")
                    last = j
        found += len(hits)
        text = "\n".join(block)
        if used + len(text) > limit:
            out.append(f"... (more found; search for something more exact, or in one file)")
            break
        out.append(text)
        used += len(text)
    if not found:
        return f"\"{words}\" is not in {shown(asked)}"
    return "\n".join(out)


def look_at_image(args):
    """Tool results are text only, so the image goes to the local model itself
    through Ollama's API (MASCOT_VISION_MODEL, the model the bubble talks to,
    without "ollama:"), and its description comes back"""
    path, asked = home_path(args.get("path"))
    model = os.environ.get("MASCOT_VISION_MODEL", "")
    if not model:
        raise ToolError("images can only be looked at with a local model")
    if os.path.isdir(path):
        raise ToolError(f"{shown(asked)} is a directory, use list_directory")
    try:
        with open(path, "rb") as file:
            data = file.read(IMAGE_LIMIT + 1)
    except FileNotFoundError:
        raise not_found(asked)
    except OSError as e:
        raise ToolError(f"cannot read {shown(asked)}: {e.strerror}")
    if len(data) > IMAGE_LIMIT:
        raise ToolError(f"{shown(asked)} is too big (over {IMAGE_LIMIT // 1024 // 1024} MB)")
    # What Ollama can load
    if not (data.startswith(b"\x89PNG") or data.startswith(b"\xff\xd8") or data[:4] == b"RIFF" and data[8:12] == b"WEBP"):
        raise ToolError(f"{shown(asked)} is not a PNG, JPEG or WebP image")
    question = " ".join(str(args.get("question") or "").split())
    prompt = "Describe this image in a few sentences: what is in it, the colours and the mood." \
        + (f" Then answer this about it: {question}" if question else "")
    url = ollama_url("/api/generate")
    body = json.dumps({"model": model, "prompt": prompt, "images": [base64.b64encode(data).decode()],
                       "stream": False, "think": False}).encode()
    request = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            answer = json.loads(response.read())
    except urllib.error.HTTPError as e:
        try:
            reason = json.loads(e.read()).get("error") or str(e)
        except ValueError:
            reason = str(e)
        raise ToolError(f"Ollama could not look at {shown(asked)}: {reason}")
    except (OSError, ValueError) as e:
        raise ToolError(f"could not reach Ollama: {e}")
    description = str(answer.get("response") or "").strip()
    if not description:
        raise ToolError(f"Ollama said nothing about {shown(asked)}")
    return f"{shown(asked)}: {description}"


# The todo list is a Markdown file: one "- [ ] item" line per item; other lines
# (a heading, notes) are kept as they are. Items are numbered from 1 in order
TODO_ITEM = "- [ ] "


def todo_file():
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("the todo list is only there with a local model")
    path = os.environ.get("MASCOT_TODO_FILE", "")
    if not os.path.isabs(path):
        raise ToolError("no todo list")
    return path


def todo_change(change):
    return locked_change(todo_file(), change)


def locked_change(path, change):
    """Runs change(lines) -> message on the file's lines, under a lock on its
    directory, and writes them back (atomically) if they changed"""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    lock = os.open(directory, os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(path, encoding="utf-8") as file:
                lines = file.read().splitlines()
        except FileNotFoundError:
            lines = []
        before = list(lines)
        message = change(lines)
        if lines != before:
            temp = f"{path}.{os.getpid()}.tmp"
            with open(temp, "w", encoding="utf-8") as file:
                file.write("".join(line + "\n" for line in lines))
            os.replace(temp, path)
        return message
    finally:
        os.close(lock)


def changed(note):
    """Tells the bubble what really changed (on stderr, which aichat passes on),
    so it can show it whatever the reply claims"""
    print(f"mascot-tools: {note}", file=sys.stderr)


def todo_items(lines):
    """(line index, text) of each item"""
    return [(i, line[len(TODO_ITEM):].strip()) for i, line in enumerate(lines)
            if line.startswith(TODO_ITEM) and line[len(TODO_ITEM):].strip()]


def todo_listing(lines):
    items = todo_items(lines)
    if not items:
        return "The todo list is empty."
    return "\n".join(f"{n}. {text}" for n, (_, text) in enumerate(items, 1))


def list_todos(args):
    def listing(lines):
        # The user never sees a tool's output, and models like to say "here is
        # your list" without it: the bubble shows these if the reply has not
        print("mascot-todos: " + json.dumps([text for _, text in todo_items(lines)]),
              file=sys.stderr)
        return todo_listing(lines)
    return todo_change(listing)


def add_todo(args):
    text = " ".join(str(args.get("item") or "").split())[:TODO_LIMIT]
    if not text:
        raise ToolError("nothing to add")

    def change(lines):
        lines.append(TODO_ITEM + text)
        changed(f"todo: added {text}")
        return f"added: {text}\n\n" + todo_listing(lines)
    return todo_change(change)


def find_todo(lines, which):
    """(line index, text) of the one item which names: its number or (part of) its text"""
    items = todo_items(lines)
    if which.isdigit():
        n = int(which)
        if not 1 <= n <= len(items):
            raise ToolError(f"there is no item {n}\n\n" + todo_listing(lines))
        return items[n - 1]
    found = [item for item in items if item[1].lower() == which.lower()] \
        or [item for item in items if which.lower() in item[1].lower()]
    if not found:
        raise ToolError(f"no item matches \"{which}\"\n\n" + todo_listing(lines))
    if len(found) > 1:
        raise ToolError(f"more than one item matches \"{which}\": "
                        + "; ".join(text for _, text in found) + " - say which by its number")
    return found[0]


def find_todos(lines, which):
    """The items which names, by the numbers they have now: one item (see
    find_todo), or several, e.g. "1, 4", "1 og 4", "milk; bread" """
    try:
        return [find_todo(lines, which)]
    except ToolError as one:
        parts = [part for part in re.split(r"\s*(?:,|;|\band\b|\bog\b|\s(?=\d+(?:\s|,|$)))\s*", which) if part]
        if len(parts) < 2:
            raise one
        found = []
        for part in parts:
            item = find_todo(lines, part)
            if item not in found:
                found.append(item)
        return found


def remove_todo(args):
    which = " ".join(str(args.get("item") or "").split())
    if not which:
        raise ToolError("say which item to remove")

    def change(lines):
        found = find_todos(lines, which)
        for index, text in sorted(found, reverse=True):
            del lines[index]
        for _, text in found:
            changed(f"todo: removed {text}")
        return "removed: " + "; ".join(text for _, text in found) + "\n\n" + todo_listing(lines)
    return todo_change(change)


def edit_todo(args):
    which = " ".join(str(args.get("item") or "").split())
    text = " ".join(str(args.get("text") or "").split())[:TODO_LIMIT]
    if not which:
        raise ToolError("say which item to change")
    if not text:
        raise ToolError("say what the item should say instead")

    def change(lines):
        index, old = find_todo(lines, which)
        lines[index] = TODO_ITEM + text
        changed(f"todo: changed {old} → {text}")
        return f"changed: {old} → {text}\n\n" + todo_listing(lines)
    return todo_change(change)


# The reminders are a Markdown file too, one "- YYYY-MM-DD HH:MM[:SS] text" line
# per reminder (local time), kept in time order; other lines are kept. The
# bubble reads it itself and shows each one when it is due, or when Mascot
# starts, if it was not running then; due_reminders then takes them off
REMINDER = re.compile(r"^- (\d{4}-\d\d-\d\d \d\d:\d\d(?::\d\d)?) (.*\S)\s*$")
UNITS = {"s": 1, "m": 60, "h": 3600, "t": 3600, "d": 86400}
DAYS = {"i dag": 0, "idag": 0, "today": 0, "i morgen": 1, "imorgen": 1, "tomorrow": 1}


def reminder_file():
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("reminders are only there with a local model")
    path = os.environ.get("MASCOT_REMINDER_FILE", "")
    if not os.path.isabs(path):
        raise ToolError("no reminders")
    return path


def parse_when(when, now):
    """The time (epoch seconds) for when: a duration ("10m", "1h30m", "2 hours",
    "45 sek"; a bare number is minutes), a time of day ("12:00", "kl. 12",
    today or else tomorrow), or a date and time ("2026-10-19 12:00",
    "19.10.26 12:00", "19.10 kl 12", "i morgen 12:00", "tomorrow 9"); None if it
    is none of them"""
    when = " ".join(when.lower().split())
    clock = bool(re.search(r"\bkl\b", when))  # "kl 12" is a time, "12" minutes
    when = re.sub(r"^(in|om) ", "", re.sub(r"\s*\bkl\b\.?\s*", " ", when).strip())
    days = None  # "i morgen 12:00": days from today
    m = re.match(r"(i morgen|imorgen|tomorrow|i dag|idag|today) ", when)
    if m:
        days, clock, when = DAYS[m.group(1)], True, when[m.end():]
    if re.fullmatch(r"\d+", when) and not clock:
        return now + int(when) * 60
    if re.fullmatch(r"(\d+\s*[a-zæøå]+\s*((and|og)\s*)?)+", when):
        parts = re.findall(r"(\d+)\s*([a-zæøå]+)", when)
        if not all(unit[0] in UNITS for _, unit in parts):
            return None
        return now + sum(int(n) * UNITS[unit[0]] for n, unit in parts)
    # [date ]hour[:minute[:second]]; "19.10" alone is a time, as in Danish
    m = re.fullmatch(r"(?:(?:(\d{4})-(\d\d?)-(\d\d?)|(\d\d?)\.(\d\d?)\.?(\d{4}|\d\d)?)[ t])?"
                     r"(\d\d?)(?:[:.](\d\d))?(?::(\d\d))?", when)
    if not m or not (m.group(8) or clock or m.group(1) or m.group(4)) or (days is not None and (m.group(1) or m.group(4))):
        return None
    if m.group(1):
        year, month, day = int(m.group(1)), int(m.group(2)), int(m.group(3))
    elif m.group(4):
        y = m.group(6)
        year = (int(y) + (2000 if len(y) == 2 else 0)) if y else time.localtime(now).tm_year
        month, day = int(m.group(5)), int(m.group(4))
    else:
        year, month, day = time.localtime(now)[:3]
        day += days or 0
    hour, minute, second = int(m.group(7)), int(m.group(8) or 0), int(m.group(9) or 0)
    if not (1 <= month <= 12 and 1 <= day <= 31 and hour < 24 and minute < 60 and second < 60):
        return None
    at = time.mktime((year, month, day, hour, minute, second, 0, 0, -1))
    # A time of day that has passed is tomorrow's, a date without a year next year's
    if at <= now and not (m.group(1) or m.group(6) or days is not None):
        if m.group(4):
            year += 1
        else:
            day += 1
        at = time.mktime((year, month, day, hour, minute, second, 0, 0, -1))
    return at


def stamp(at):
    seconds = time.localtime(at).tm_sec
    return time.strftime("%Y-%m-%d %H:%M:%S" if seconds else "%Y-%m-%d %H:%M", time.localtime(at))


def shown_time(at):
    return time.strftime("%a %Y-%m-%d %H:%M", time.localtime(at))


def reminder_items(lines):
    """(line index, epoch seconds, text) of each reminder, in time order"""
    items = []
    for i, line in enumerate(lines):
        m = REMINDER.match(line)
        if m:
            fmt = "%Y-%m-%d %H:%M:%S" if m.group(1).count(":") == 2 else "%Y-%m-%d %H:%M"
            try:
                items.append((i, time.mktime(time.strptime(m.group(1), fmt)), m.group(2)))
            except ValueError:
                pass
    return sorted(items, key=lambda item: item[1])


def reminder_listing(lines):
    items = reminder_items(lines)
    if not items:
        return "There are no reminders."
    return "\n".join(f"{n}. {shown_time(at)}: {text}" for n, (_, at, text) in enumerate(items, 1))


def keep_in_order(lines):
    """Puts the reminder lines in time order, after any other lines"""
    items = reminder_items(lines)
    reminders = [lines[i] for i, _, _ in items]
    lines[:] = [line for i, line in enumerate(lines) if i not in {i for i, _, _ in items}] + reminders


def set_reminder(args):
    now = time.time()
    when = " ".join(str(args.get("when") or "").split())
    text = " ".join(str(args.get("text") or "").split())[:TODO_LIMIT]
    if not when and text:
        # .remind <when> <text>: the longest start of it that is a time
        words = text.split()
        for n in range(len(words) - 1, 0, -1):
            if parse_when(" ".join(words[:n]), now) is not None:
                when, text = " ".join(words[:n]), " ".join(words[n:])
                break
    if not text:
        raise ToolError("say what to remind of")
    if not when:
        raise ToolError("say when, e.g. 10m, 1h30m, 12:00 or 2026-10-19 12:00")
    at = parse_when(when, now)
    if at is None:
        raise ToolError(f"cannot tell when \"{when}\" is - use e.g. 10m, 1h30m, 12:00 or 2026-10-19 12:00")
    if at <= now:
        raise ToolError(f"{shown_time(at)} has passed")

    def change(lines):
        lines.append(f"- {stamp(at)} {text}")
        keep_in_order(lines)
        changed(f"reminder: {shown_time(at)}: {text}")
        return f"set for {shown_time(at)}: {text}\n\n" + reminder_listing(lines)
    return locked_change(reminder_file(), change)


def list_reminders(args):
    return locked_change(reminder_file(), reminder_listing)


def cancel_reminder(args):
    which = " ".join(str(args.get("item") or "").split())
    if not which:
        raise ToolError("say which reminder to cancel")

    def change(lines):
        items = reminder_items(lines)
        if which.isdigit():
            n = int(which)
            if not 1 <= n <= len(items):
                raise ToolError(f"there is no reminder {n}\n\n" + reminder_listing(lines))
            found = [items[n - 1]]
        else:
            found = [item for item in items if item[2].lower() == which.lower()] \
                or [item for item in items if which.lower() in item[2].lower()]
        if not found:
            raise ToolError(f"no reminder matches \"{which}\"\n\n" + reminder_listing(lines))
        if len(found) > 1:
            raise ToolError(f"more than one reminder matches \"{which}\": "
                            + "; ".join(text for _, _, text in found) + " - say which by its number")
        index, at, text = found[0]
        del lines[index]
        changed(f"reminder cancelled: {shown_time(at)}: {text}")
        return f"cancelled: {text}\n\n" + reminder_listing(lines)
    return locked_change(reminder_file(), change)


def due_reminders(args):
    """For the bubble, not the model: takes off the reminders due by "until"
    (epoch seconds), once it has shown them"""
    until = float(args.get("until") or 0)

    def change(lines):
        due = {i for i, at, _ in reminder_items(lines) if at <= until}
        lines[:] = [line for i, line in enumerate(lines) if i not in due]
        return f"{len(due)} done"
    return locked_change(reminder_file(), change)


# Shell history files, (shell, path); last_commands reads the one written last,
# so the shell in use wins whatever $SHELL says
def history_files():
    home = os.path.expanduser("~")
    data = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
    zdotdir = os.environ.get("ZDOTDIR") or home
    files = [("fish", os.path.join(data, "fish/fish_history")),
             ("bash", os.path.join(home, ".bash_history"))]
    files += [("zsh", os.path.join(zdotdir, name)) for name in (".zsh_history", ".histfile")]
    files.append(("zsh", os.path.join(data, "zsh/history")))
    # Only when exported, which shells do not do themselves
    histfile = os.environ.get("HISTFILE")
    if histfile:
        shell = os.path.basename(os.environ.get("SHELL", ""))
        files.insert(0, (shell if shell in ("bash", "zsh") else "zsh", os.path.expanduser(histfile)))
    return files


def unmetafy(data):
    """zsh writes some bytes (e.g. those of æ, ø, å) as 0x83 and the byte ^ 32"""
    out = bytearray()
    meta = False
    for byte in data:
        if meta:
            out.append(byte ^ 32)
            meta = False
        elif byte == 0x83:
            meta = True
        else:
            out.append(byte)
    return bytes(out)


def history_entries(shell, text):
    """[(unix time or None, command)], oldest first, from the end of a history
    file (the first entry may be cut off)"""
    entries = []
    if shell == "fish":
        # - cmd: echo hi\n  when: 1697000000
        for line in text.split("\n"):
            if line.startswith("- cmd: "):
                command = line[len("- cmd: "):]
                command = re.sub(r"\\(.)", lambda m: "\n" if m[1] == "n" else m[1], command)
                entries.append([None, command])
            elif line.startswith("  when: ") and entries and line[8:].strip().isdigit():
                entries[-1][0] = int(line[8:].strip())
        return [tuple(e) for e in entries]
    stamp = None
    continued = False
    for line in text.split("\n"):
        if continued:
            # zsh: a line of a command over several lines ends in a backslash
            entries[-1][1] += "\n" + line
        elif shell == "bash" and re.fullmatch(r"#\d{9,}", line):
            stamp = int(line[1:])  # HISTTIMEFORMAT
            continue
        elif shell == "zsh" and (m := re.match(r": (\d+):\d+;(.*)", line)):
            entries.append([int(m[1]), m[2]])  # EXTENDED_HISTORY
        elif line.strip():
            entries.append([stamp, line])
        else:
            continue
        stamp = None
        continued = shell == "zsh" and entries[-1][1].endswith("\\")
        if continued:
            entries[-1][1] = entries[-1][1][:-1]
    return [tuple(e) for e in entries]


# Commands that may hold a password, key or token: the model never sees them
SECRET_WORDS = re.compile(r"pass(wd|word)?\b|secret|token|api[_-]?key|apikey|auth|bearer|credential|private[_-]?key"
                          r"|\b(gpg|pass|ssh-add|age|openssl)\b|-p\S|--password|://[^/\s:]+:[^@\s]+@", re.I)
RANDOM_LOOKING = re.compile(r"[A-Za-z0-9+/_=-]{32,}")


def looks_secret(command):
    if SECRET_WORDS.search(command):
        return True
    # Long runs of letters and digits mixed, like keys; not paths or words
    return any(re.search(r"\d", run) and re.search(r"[A-Za-z]", run) and "/" not in run
               for run in RANDOM_LOOKING.findall(command))


def last_commands(args):
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("the shell history can only be read with a local model")
    try:
        count = int(args.get("count") or COMMANDS_LEAST)
    except (TypeError, ValueError):
        count = COMMANDS_LEAST
    count = max(COMMANDS_LEAST, min(COMMANDS_LIMIT, count))
    text = str(args.get("text") or "").strip().lower()

    found = [(os.path.getmtime(path), shell, path) for shell, path in history_files() if os.path.isfile(path)]
    if not found:
        raise ToolError("no shell history found (zsh, bash or fish)")
    _, shell, path = max(found)
    with open(path, "rb") as file:
        file.seek(0, os.SEEK_END)
        size = file.tell()
        file.seek(max(0, size - HISTORY_TAIL))
        data = file.read()
    if shell == "zsh":
        data = unmetafy(data)
    entries = history_entries(shell, data.decode("utf-8", "replace"))
    if size > HISTORY_TAIL:
        entries = entries[1:]  # may be cut off
    # The newest of each command (shells may keep duplicates), as the model may
    # see it: text cannot find what is hidden
    newest = []
    for at, command in reversed(entries):
        command = command.strip()
        if command and command not in (c for _, c in newest):
            newest.append((at, command))
    newest = [(at, "[hidden: may hold a password or key]" if looks_secret(c) else c) for at, c in newest]
    if text:
        newest = [(at, c) for at, c in newest if text in c.lower()]
    shown_commands = list(reversed(newest[:count]))
    if not shown_commands:
        return f"no command with \"{text}\" among the last ones" if text else "the shell history is empty"

    lines = [f"The user's last {shell} command{'s' if len(shown_commands) > 1 else ''}, oldest first "
             "(only the command is known, not its output or whether it failed):"]
    for i, (at, command) in enumerate(shown_commands, 1 - len(shown_commands)):
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(at)) + " " if at else ""
        command = command.replace("\n", "\n  ")
        last = "" if i or text else "  <- the last command"
        lines.append(f"- {when}{command}{last}")
    if shell == "bash":
        lines.append("(bash writes its history when a shell exits, unless PROMPT_COMMAND runs history -a, so a "
                     "terminal still open may have newer commands)")
    return "\n".join(lines)


def sleep_mode(args):
    """Puts all mascots to sleep until wake_up (or wakes them up now): no
    remarks, and reminders wait. A plain mascot wake (hypridle) does not end it"""
    now = time.time()
    when = " ".join(str(args.get("wake_up") or "").split())
    if not when:
        raise ToolError("say when to wake up, e.g. 30m, 1h or 14:00 (or now)")
    if when.lower() in ("0", "now", "nu"):
        message, at = {"event": "wake", "all": True}, None
    else:
        at = parse_when(when, now)
        if at is None:
            raise ToolError(f"cannot tell when \"{when}\" is - use e.g. 30m, 1h30m or 14:00")
        if at <= now:
            raise ToolError(f"{shown_time(at)} has passed")
        message = {"event": "sleep", "minutes": round((at - now) / 60, 2)}
    path = os.environ.get("MASCOT_CHAT_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                                                              "mascotd-chat.sock")
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as chat:
            chat.connect(path)
            chat.sendall(json.dumps(message, separators=(",", ":")).encode() + b"\n")
    except OSError as e:
        raise ToolError(f"cannot reach Mascot ({e.strerror})")
    if at is None:
        changed("awake")
        return "the mascots are awake"
    changed(f"asleep until {shown_time(at)}")
    return (f"the mascots sleep until {shown_time(at)}: no remarks, and reminders wait; they lie down once the "
            "bubble is closed")


# Troubleshooting: what the system's own tools and logs say, read without
# sudo. Every answer says what could not be seen, so the model has no gap to
# guess into, and tells the bubble whether it found anything ("mascot-found"),
# or not ("mascot-unsure": the mascot shows it does not know)
SYSTEM_AREAS = ("network", "sound", "crashes", "services")
LOG_LINES = 60  # lines of the log read_log shows, the newest
LOG_SCAN = 5000  # lines of the kernel log searched for firewall blocks
SECRET_VALUE = re.compile(r"((?:pass(?:wd|word)?|secret|token|api[_-]?key|apikey|auth[_-]?key|bearer|credential)"
                          r"\s*[=:]\s*)\S+", re.I)
SINCE = re.compile(r"^(\d+)\s*(s|m|min|h|t|d)$", re.I)


def run(*command, timeout=8):
    """(stdout, stderr) of a command, or (None, why) when it cannot run"""
    import subprocess
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL,
                              env=dict(os.environ, LC_ALL="C", SYSTEMD_COLORS="0", SYSTEMD_PAGER=""))
    except FileNotFoundError:
        return None, f"{command[0]} is not installed"
    except subprocess.TimeoutExpired:
        return None, f"{command[0]} took too long"
    return done.stdout, done.stderr


def masked(line):
    """A log line without what looks like a password or key in it"""
    line = SECRET_VALUE.sub(r"\1[hidden]", line)
    return RANDOM_LOOKING.sub(lambda m: "[hidden]" if re.search(r"\d", m[0]) and re.search(r"[A-Za-z]", m[0])
                              and "/" not in m[0] else m[0], line)


def journal(*args):
    """(lines, why only part of it could be seen or None) of journalctl"""
    out, err = run("journalctl", "-q", "--no-pager", *args)
    if out is None:
        return [], err
    partial = None
    if "not seeing messages from other users and the system" in err:
        partial = ("the system's log (only the user's own: they are not in the systemd-journal or wheel group, "
                   "`sudo journalctl` shows it)")
    elif err.strip() and not out.strip():
        partial = f"the log ({err.strip().splitlines()[0]})"
    lines = [masked(line) for line in out.splitlines() if line.strip()]
    if "short-iso" in args:
        # Oldest first: with --grep and -n, journalctl gives the newest first. A
        # message's further lines (indented) stay with it
        entries = []
        for line in lines:
            if line[:1].isspace() and entries:
                entries[-1].append(line)
            else:
                entries.append([line])
        lines = [line for entry in sorted(entries, key=lambda e: e[0][:25]) for line in entry]
    return lines, partial


def since_option(since):
    """journalctl's --since for "1h", "30m", "today", "this boot"... (None: this boot)"""
    since = " ".join(str(since or "").lower().split())
    if not since or since in ("boot", "this boot", "since boot"):
        return None
    m = SINCE.match(since)
    if m:
        return f"-{m[1]}{ {'s': 's', 'm': 'min', 'min': 'min', 'h': 'h', 't': 'h', 'd': 'd'}[m[2]] }"
    if since in ("today", "i dag", "idag", "yesterday", "i går", "igår"):
        return "today" if since in ("today", "i dag", "idag") else "yesterday"
    if re.match(r"^\d{4}-\d\d-\d\d( \d\d:\d\d(:\d\d)?)?$", since):
        return since
    raise ToolError(f"cannot tell when \"{since}\" is - use e.g. 30m, 2h, 1d, today or this boot")


def firewall_rules():
    """(lines about the firewall, what could not be seen)"""
    lines, missing = [], []
    conf = "/etc/ufw/ufw.conf"
    if os.path.exists(conf):
        try:
            enabled = re.search(r"^ENABLED=(\w+)", open(conf).read(), re.M)
            lines.append(f"UFW: {'on' if enabled and enabled[1] == 'yes' else 'off'}")
        except OSError:
            missing.append("whether UFW is on (`sudo ufw status`)")
        try:
            policy = re.search(r'^DEFAULT_INPUT_POLICY="?(\w+)', open("/etc/default/ufw").read(), re.M)
            if policy:
                lines.append(f"UFW incoming by default: {policy[1].lower()}")
        except OSError:
            pass
        rules = []
        for name in ("/etc/ufw/user.rules", "/etc/ufw/user6.rules"):
            try:
                for line in open(name):
                    # "### tuple ### allow udp 27015 0.0.0.0/0 any 0.0.0.0/0 in"
                    m = re.match(r"^### tuple ### (\S+) (\S+) (\S+) (\S+) (\S+) (\S+)(?: (in|out))?"
                                 r"(?: comment=([0-9a-f]+))?", line)
                    if m:
                        what, proto, port, to, sport, source, way, comment = m.groups()
                        rule = (f"{what} {way or 'in'} {'any' if proto == 'any' else proto} port "
                                f"{'any' if port == 'any' else port.replace(':', '-')}"
                                + ("" if source in ("0.0.0.0/0", "::/0") else f" from {source}"))
                        # ufw keeps a rule's comment in hex; it tells what the rule is for
                        try:
                            rule += f' ("{masked(bytes.fromhex(comment).decode()[:40])}")' if comment else ""
                        except ValueError:
                            pass
                        if rule not in rules:
                            rules.append(rule)
            except OSError:
                missing.append(f"UFW's rules ({name}, `sudo ufw status`)")
                break
        else:
            lines.append("UFW rules: " + ("; ".join(rules) if rules else "none of the user's own"))
    else:
        out, _ = run("systemctl", "is-active", "firewalld")
        if out and out.strip() == "active":
            missing.append("firewalld's rules (they need root: `sudo firewall-cmd --list-all`)")
        else:
            lines.append("No UFW; firewalld is not running (an nftables or iptables firewall needs root to see: "
                         "`sudo nft list ruleset`)")
    return lines, missing


def firewall_blocks(since):
    """(lines about what UFW blocked, how many blocks, what could not be seen)"""
    args = ["-k", "-o", "short-iso", "-n", str(LOG_SCAN)] + (["--since", since] if since else ["-b"])
    log, partial = journal(*args)
    groups = {}
    for line in log:
        if "UFW BLOCK" not in line:
            continue
        field = dict(re.findall(r"\b([A-Z]+)=(\S*)", line))
        proto = {"2": "IGMP", "1": "ICMP"}.get(field.get("PROTO", ""), field.get("PROTO", "?"))
        dst = field.get("DST", "")
        kind = ("broadcast" if dst.endswith(".255") or dst == "255.255.255.255" else
                "multicast" if re.match(r"^(22[4-9]|23\d)\.", dst) or dst.lower().startswith("ff") else "to this computer")
        key = (proto, field.get("DPT", ""), field.get("IN", ""), kind)
        g = groups.setdefault(key, {"count": 0, "sources": set(), "last": ""})
        g["count"] += 1
        g["sources"].add(field.get("SRC", "?"))
        g["last"] = line[11:16]
    lines = []
    for (proto, port, interface, kind), g in sorted(groups.items(), key=lambda kv: -kv[1]["count"])[:12]:
        sources = sorted(g["sources"])
        lines.append(f"- {proto}{' port ' + port if port else ''} {kind} on {interface or '?'}: {g['count']}x, "
                     f"last {g['last']}, from {', '.join(sources[:3])}{' and more' if len(sources) > 3 else ''}")
    return lines, sum(g["count"] for g in groups.values()), [partial] if partial else []


def check_network(args):
    found, lines, missing = 0, [], []
    out, err = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device")
    if out is not None:
        devices = [d.split(":") for d in out.splitlines() if d and not re.match(r"^(lo|p2p-dev)", d)]
        lines.append("Connections: " + "; ".join(f"{d[0]} ({d[1]}) {d[2]}" + (f" to {d[3]}" if len(d) > 3 and d[3] else "")
                                                 for d in devices if len(d) >= 3))
        if not any(len(d) >= 3 and d[2] == "connected" for d in devices):
            found += 1
            lines.append("No device is connected.")
    else:
        out, err = run("ip", "-brief", "address")
        if out is None:
            missing.append("the network devices (" + err + ")")
        else:
            lines.append("Devices: " + "; ".join(" ".join(l.split()) for l in out.splitlines() if not l.startswith("lo ")))
    # The local networks, so a firewall rule for the LAN is not guessed from one address
    out, _ = run("ip", "-4", "-o", "address", "show", "scope", "global")
    nets = []
    for m in re.finditer(r"^\d+:\s+(\S+)\s+inet\s+(\S+)", out or "", re.M):
        try:
            nets.append(f"{m[1]} {ipaddress.ip_interface(m[2]).network}")
        except ValueError:
            pass
    if nets:
        lines.append("Local networks (IPv4): " + "; ".join(nets))
    out, err = run("ss", "-tulnH")
    if out is None:
        missing.append("the open ports (" + err + ")")
    else:
        ports = sorted({f"{l.split()[0]} {l.split()[4].rsplit(':', 1)[-1]}" for l in out.splitlines() if len(l.split()) > 4},
                       key=lambda p: (p.split()[0], int(p.split()[1]) if p.split()[1].isdigit() else 0))
        lines.append("Listening here (any program): " + (", ".join(ports[:40]) if ports else "nothing"))
    rules, cannot = firewall_rules()
    lines += rules
    missing += cannot
    since = since_option(args.get("since"))
    blocks, count, cannot = firewall_blocks(since)
    missing += cannot
    if blocks:
        found += 1
        lines.append(f"The firewall blocked {count} incoming packets {'since ' + str(args.get('since')) if since else 'since boot'} "
                     "(multicast and broadcast are often harmless noise, but games find each other on a LAN with them):")
        lines += blocks
    elif rules or os.path.exists("/etc/ufw/ufw.conf"):
        lines.append("The firewall blocked nothing " + ("since " + str(args.get("since")) if since else "since boot")
                     + " (UFW logs what it blocks, unless its logging is off).")
    return found, lines, missing


def check_sound(args):
    found, lines, missing = 0, [], []
    out, _ = run("systemctl", "--user", "is-active", "pipewire", "pipewire-pulse", "wireplumber")
    if out is not None:
        states = dict(zip(("pipewire", "pipewire-pulse", "wireplumber"), out.split()))
        down = [name for name, state in states.items() if state != "active"]
        lines.append("Sound services: " + ", ".join(f"{n} {s}" for n, s in states.items()))
        found += bool(down)
    out, err = run("wpctl", "status")
    if out is None:
        missing.append("PipeWire's devices (" + err + ")")
    else:
        part = re.search(r"^Audio\n(.*?)(?=^\S)", out + "\nEnd\n", re.S | re.M)
        audio = [re.sub(r"[│├└─]", " ", l).rstrip() for l in (part[1] if part else "").splitlines()]
        audio = [re.sub(r"\s+", " ", l).strip() for l in audio if l.strip()]
        lines.append("Audio (* = the default): " + " | ".join(audio[:40]))
        if not re.search(r"Sinks:\s*\|?\s*\*", " | ".join(audio)) and "Sinks:" in " | ".join(audio):
            found += 1
            lines.append("No default output (sink).")
        volume, _ = run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        if volume:
            lines.append("Default output: " + volume.strip())
            if "MUTED" in volume or re.search(r"Volume: 0\.00", volume):
                found += 1
    log, partial = journal("--user", "-b", "-p", "warning", "-o", "short-iso", "-n", "20",
                           "-u", "pipewire", "-u", "pipewire-pulse", "-u", "wireplumber")
    if partial:
        missing.append(partial)
    if log:
        found += 1
        lines.append("Warnings and errors from the sound services since boot (newest last):")
        lines += [f"- {l[11:]}" for l in log[-12:]]
    else:
        lines.append("No warnings or errors from the sound services since boot.")
    return found, lines, missing


def check_crashes(args):
    found, lines, missing = 0, [], []
    since = since_option(args.get("since")) or "-7d"
    out, err = run("coredumpctl", "list", "--json=short", f"--since={since}", "-q")
    program = str(args.get("program") or "").strip().lower()
    if out is None:
        missing.append("the crashes (" + err + ")")
        return found, lines, missing
    try:
        dumps = json.loads(out) if out.strip() else []
    except json.JSONDecodeError:
        dumps = []
    if program:
        dumps = [d for d in dumps if program in os.path.basename(str(d.get("exe", ""))).lower()]
    signals = {6: "SIGABRT", 11: "SIGSEGV", 4: "SIGILL", 7: "SIGBUS", 8: "SIGFPE", 5: "SIGTRAP", 3: "SIGQUIT"}
    by_program = {}
    for d in dumps:
        name = os.path.basename(str(d.get("exe", "?")))
        p = by_program.setdefault(name, {"count": 0, "last": 0, "sig": d.get("sig"), "pid": d.get("pid")})
        p["count"] += 1
        if d.get("time", 0) >= p["last"]:
            p.update(last=d.get("time", 0), sig=d.get("sig"), pid=d.get("pid"))
    when = "in the last 7 days" if since == "-7d" else f"since {args.get('since')}"
    if not by_program:
        lines.append(f"No crashes{' of ' + program if program else ''} {when} (coredumpctl).")
        return found, lines, missing
    found += 1
    lines.append(f"Crashes {when}, newest first:")
    for name, p in sorted(by_program.items(), key=lambda kv: -kv[1]["last"])[:15]:
        at = time.strftime("%Y-%m-%d %H:%M", time.localtime(p["last"] / 1e6)) if p["last"] else "?"
        lines.append(f"- {name}: {p['count']}x, last {at} ({signals.get(p['sig'], 'signal ' + str(p['sig']))})")
    if program:
        newest = max(by_program.values(), key=lambda p: p["last"])
        info, _ = run("coredumpctl", "info", str(newest["pid"]), "--no-pager", timeout=15)
        trace = re.search(r"Stack trace of thread.*?\n((?:\s+#\d+.*\n?){1,12})", info or "")
        if trace:
            lines.append("Where the newest one crashed (stack trace, innermost first):")
            lines += [" " + masked(" ".join(l.split())) for l in trace[1].splitlines()]
        else:
            lines.append("No stack trace was saved for it.")
    return found, lines, missing


def check_services(args):
    found, lines, missing = 0, [], []
    for scope in ([], ["--user"]):
        out, err = run("systemctl", *scope, "--failed", "--no-legend", "--plain")
        name = "user" if scope else "system"
        if out is None:
            missing.append(f"the failed {name} services ({err})")
            continue
        failed = [l.split()[0] for l in out.splitlines() if l.strip()]
        found += bool(failed)
        lines.append(f"Failed {name} services: " + (", ".join(failed) if failed else "none"))
    since = since_option(args.get("since"))
    log, partial = journal("-p", "err", "-o", "json", "-n", "400", *(["--since", since] if since else ["-b"]))
    if partial:
        missing.append(partial)
    errors = {}
    for line in log:
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        who = e.get("SYSLOG_IDENTIFIER") or e.get("_COMM") or "?"
        message = e.get("MESSAGE")
        message = message if isinstance(message, str) else "(binary)"
        g = errors.setdefault(who, {"count": 0, "last": ""})
        g["count"] += 1
        g["last"] = masked(" ".join(message.split()))[:200]
    if errors:
        found += 1
        lines.append(f"Errors in the log {'since ' + str(args.get('since')) if since else 'since boot'}, by program "
                     "(the most first, with its newest message):")
        lines += [f"- {who} {g['count']}x: {g['last']}" for who, g in sorted(errors.items(), key=lambda kv: -kv[1]["count"])[:12]]
    else:
        lines.append("No errors in the log " + ("since " + str(args.get("since")) if since else "since boot") + ".")
    return found, lines, missing


def sure(found):
    """Tells the bubble whether the tool found something to go on"""
    print("mascot-found" if found else "mascot-unsure", file=sys.stderr)


def check_system(args):
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("the system can only be checked with a local model")
    area = str(args.get("area") or "").strip().lower()
    if area not in SYSTEM_AREAS:
        raise ToolError("area must be one of " + ", ".join(SYSTEM_AREAS))
    found, lines, missing = {"network": check_network, "sound": check_sound, "crashes": check_crashes,
                             "services": check_services}[area](args)
    sure(found)
    result = [f"What the system says about {area} (read without sudo):"] + lines
    if missing:
        result.append("Could not see: " + "; ".join(missing) + ".")
    if not found:
        result.append(f"Nothing here points to a problem with {area}. Say so, and that you cannot tell the cause "
                      "from this; do not guess one.")
    return "\n".join(result)[:read_limit()]


def read_log(args):
    """The newest lines of the system's log (journalctl), filtered"""
    if not os.environ.get("MASCOT_TOOLS_LOCAL") == "1":
        raise ToolError("the system's log can only be read with a local model")
    search = str(args.get("search") or "").strip()
    unit = str(args.get("unit") or "").strip()
    if unit and not re.match(r"^[\w@.:-]+$", unit):
        raise ToolError(f"\"{unit}\" is not a service name")
    since = since_option(args.get("since"))
    base = ["-o", "short-iso", "-n", str(LOG_LINES)] + (["--since", since] if since else ["-b"])
    if args.get("kernel"):
        base.append("-k")
    if search:
        base += ["--grep", search, "--case-sensitive=false"]
    log, partial = journal(*base, *(["-u", unit] if unit else []))
    if unit and not log:  # maybe the user's own service
        log, partial = journal("--user", *base, "-u", unit)
    sure(log)
    what = " ".join(filter(None, [f"of {unit}" if unit else "", "from the kernel" if args.get("kernel") else "",
                                  f"with \"{search}\"" if search else ""]))
    when = f"since {args.get('since')}" if since else "since boot"
    if not log:
        return (f"No lines in the log {what} {when}." + (f" Could not see: {partial}." if partial else "")
                + " Say so; do not guess what happened.").replace("  ", " ")
    limit = read_limit() // 2
    shown, size = [], 0
    for line in reversed(log):
        size += len(line) + 1
        if size > limit:
            break
        shown.append(line)
    lines = [f"The newest {len(shown)} lines of the log {what} {when}, oldest first:".replace("  ", " ")]
    lines += reversed(shown)
    if partial:
        lines.append(f"Could not see: {partial}.")
    return "\n".join(lines)


TOOLS = {f.__name__: f for f in (get_current_weather, list_directory, read_file, search_file, look_at_image, list_todos, add_todo, remove_todo, edit_todo,
                                 set_reminder, list_reminders, cancel_reminder, due_reminders, last_commands, sleep_mode, context_size,
                                 check_system, read_log)}


def main():
    name = os.path.basename(sys.argv[0])
    try:
        if name not in TOOLS:
            raise ToolError(f"unknown tool {name}")
        try:
            args = json.loads(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].strip() else {}
        except json.JSONDecodeError:
            raise ToolError("invalid JSON arguments")
        # What it is doing, for the bubble to show while it waits
        print("mascot-doing: " + json.dumps({"tool": name, "args": args}, ensure_ascii=False),
              file=sys.stderr, flush=True)
        result = TOOLS[name](args if isinstance(args, dict) else {})
    except ToolError as e:
        result = f"error: {e}"  # for the model, which can tell the user
    output = os.environ.get("LLM_OUTPUT")
    if output:
        with open(output, "a", encoding="utf-8") as file:
            file.write(result + "\n")
        # What this put in the conversation's memory, which the bubble counts
        print(f"mascot-size: {len(result)}", file=sys.stderr)
    else:
        print(result)


if __name__ == "__main__":
    main()
